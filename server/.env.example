# ==============================================================================
# CONFIGURACIÓN DEL SERVIDOR - DASHBOARD DE FINANZAS PERSONALES
# ==============================================================================
# Copia este archivo con el nombre '.env' y completa tus valores reales.

# Puerto de escucha del servidor Express (por defecto 5000)
PUERTO=5000

# Entorno de ejecución: 'development' para desarrollo, 'production' para despliegue
NODE_ENV=development

# URI de conexión a la base de datos MongoDB Atlas
# Reemplaza <usuario>, <password> y <cluster> con tus credenciales de MongoDB Atlas
MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/finanzas_personales?retryWrites=true&w=majority

# URL del cliente web frontend (React + Vite) para la política de CORS
CLIENT_URL=http://localhost:5173

# Clave secreta criptográfica para firmar y verificar tokens JWT
# Usa una cadena aleatoria y robusta de al menos 32 caracteres en producción
JWT_SECRETO=clave_secreta_super_segura_finanzas_2026_jwt

# Tiempo de expiración del token de sesión (1 hora según requerimiento)
JWT_EXPIRA=1h

# Servidor SMTP de correo electrónico para el envío de enlaces de recuperación de contraseña
CORREO_HOST=smtp.gmail.com

# Puerto del servidor SMTP (comúnmente 587 para TLS o 465 para SSL)
CORREO_PUERTO=587

# Dirección de correo o cuenta de usuario para autenticarse en el servidor SMTP
CORREO_USUARIO=tu_correo_notificaciones@gmail.com

# Contraseña de aplicación generada en tu proveedor de correo (ej. Contraseña de Aplicación de Google)
CORREO_CLAVE=tu_contrasena_de_aplicacion
